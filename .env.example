RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente de los avisos (contacto y contratos). Requiere dominio verificado en
# Resend (ej. "HarayaDev <contacto@haraya.dev>"). Si falta, usa onboarding@resend.dev,
# que solo puede enviar al email dueño de la cuenta Resend.
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Requerido para el chat IA (widget flotante en todo el sitio). Si falta, el
# widget muestra un mensaje de error amigable en vez de fallar en silencio.
# Google AI Studio (https://aistudio.google.com/apikey) tiene tier gratuito.
GEMINI_API_KEY=
# Formato E.164 sin "+" ni espacios (ej. 56912345678). Si se deja vacío, el
# link/botón de WhatsApp simplemente no se muestra.
WHATSAPP_NUMBER=

# --- Asistente IA respondiendo el WhatsApp del negocio (webhook /api/whatsapp) ---
# Guía de conexión completa: ~/harayadev-crm/whatsapp-cloud-api-plan.md
# String secreto inventado por ti; se repite al registrar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Token permanente generado con un System User en Meta Business Manager.
WHATSAPP_TOKEN=
# ID del número en WhatsApp Manager (es un ID numérico largo, NO el teléfono).
WHATSAPP_PHONE_NUMBER_ID=

# --- Contratos (/contratar) ---
# RUT de la EIRL mostrado en el contrato. Si falta, el documento dice "[RUT por completar]".
COMPANY_RUT=
# Datos de la cuenta para transferencias, mostrados en el contrato generado. Si faltan
# BANK_NAME o BANK_ACCOUNT_NUMBER, el contrato indica que los datos se envían por
# WhatsApp/email al confirmar (el flujo funciona igual).
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_HOLDER=
BANK_RUT=
BANK_EMAIL=

# Pago online con Mercado Pago Checkout Pro (alternativa a la transferencia,
# botón "Pagar ahora" en /contratar, solo para pago único "full"). Access
# Token de tu cuenta vendedora (https://www.mercadopago.cl/developers/panel/app).
# Si falta, el botón de pago online no funciona y el flujo sigue por transferencia.
MP_ACCESS_TOKEN=
# Secreto configurado al crear el webhook en el panel de Mercado Pago, usado
# para validar la firma x-signature de las notificaciones. Si falta, el
# webhook funciona pero sin validar el origen (no recomendado en producción).
MP_WEBHOOK_SECRET=

# --- Analytics ---
# Measurement ID de GA4 (ej. G-XXXXXXXXXX). Si falta, no se carga ningún script
# de analytics. Eventos custom: whatsapp_click, contrato_generado, chat_usado.
NEXT_PUBLIC_GA_ID=
# Meta Pixel (Events Manager > Orígenes de datos > tu Pixel, en business.facebook.com).
# Si falta, no se carga el Pixel — el sitio funciona igual, independiente de GA4.
# demo_solicitada/contrato_generado/whatsapp_click se mapean a Lead/InitiateCheckout/Contact.
NEXT_PUBLIC_META_PIXEL_ID=
# Token de acceso para Conversions API (Events Manager > Configuración >
# Conversions API > Generar token de acceso). Envía el evento "Purchase" del
# lado servidor cuando el webhook de Mercado Pago confirma un pago — sobrevive
# a bloqueadores de ads. Requiere también NEXT_PUBLIC_META_PIXEL_ID; sin
# cualquiera de los dos, no se envía nada.
META_CAPI_ACCESS_TOKEN=
